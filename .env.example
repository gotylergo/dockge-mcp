# Dockge Instance URL (default: http://localhost:5001)
DOCKGE_URL="http://192.168.0.2:5001"

# Dockge-Enhanced REST API Authentication (Recommended for Dockge-Enhanced)
# Generate under Settings -> Automation in Dockge-Enhanced
DOCKGE_API_TOKEN="dge_your_api_token_here"

# Vanilla Dockge / Interactive Terminal Fallback Authentication
# Required for vanilla Dockge instances or interactive container terminal sessions
# DOCKGE_USERNAME="admin"
# DOCKGE_PASSWORD="your_password"

# MCP Server Transport: "stdio" (default for Claude Code, OpenCode, Antigravity) or "http"
MCP_TRANSPORT="stdio"
# MCP_HOST="0.0.0.0"
# MCP_PORT=8000
